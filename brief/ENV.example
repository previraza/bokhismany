# Variables d'environnement. Copier ce fichier en .env pour le développement local.
# Ne jamais commiter le fichier .env. Les valeurs réelles vont dans Vercel (Settings → Environment Variables).

# URL de connexion Neon (PostgreSQL), avec sslmode=require
DATABASE_URL=postgres://utilisateur:motdepasse@ep-xxxx.region.aws.neon.tech/bokhismany?sslmode=require

# Compte administrateur créé par le script de seed
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret de signature des sessions (chaîne aléatoire longue)
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres
