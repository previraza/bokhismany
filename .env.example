# Copier ce fichier en .env pour le développement local.
# Le fichier .env est ignoré par git : ne jamais commiter de valeur réelle.

# PostgreSQL : URL Neon en production, URL locale en développement.
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base?sslmode=require

# Compte administrateur créé par le script de seed (phase 6).
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret de signature des sessions (chaîne aléatoire d'au moins 32 caractères).
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres
