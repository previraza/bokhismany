# Copier ce fichier en .env pour le développement local.
# Le fichier .env est ignoré par git : ne jamais commiter de valeur réelle.

# PostgreSQL géré par docker-compose. Compose construit lui-même l'URL interne (db:5432).
POSTGRES_DB=bokhismany
POSTGRES_USER=bokhismany
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort
DB_PORT=5433
APP_PORT=3000

# URL utilisée par pnpm dev et les scripts hors conteneur (port exposé sur l'hôte).
DATABASE_URL=postgres://bokhismany:remplacer-par-un-mot-de-passe-fort@127.0.0.1:5433/bokhismany

# Compte administrateur créé par le script de seed.
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret de signature des sessions (chaîne aléatoire d'au moins 32 caractères).
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-d-au-moins-32-caracteres
